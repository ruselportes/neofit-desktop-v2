{
  "name": "NeofitSmsGateway",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "start": "react-native start",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "bundle": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res/",
    "patch-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/patch-bundle.ps1 -BundlePath android/app/src/main/assets/index.android.bundle"
  },
  "dependencies": {
    "react": "19.0.0",
    "react-native": "0.79.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.7",
    "@react-native-community/cli": "latest",
    "@react-native/babel-preset": "^0.85.3",
    "@react-native/metro-config": "^0.85.3",
    "@types/react": "^19.0.0",
    "typescript": "~5.7.0"
  }
}
